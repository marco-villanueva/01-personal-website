---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{project.screenshot ? (
  <div class="project-art project-art--real">
    <img
      class="art__image"
      src={`${assetBase}projects/${project.screenshot}`}
      alt={`Screenshot of the public ${project.title} website, captured November 2026`}
      loading="lazy"
      decoding="async"
      width="1440"
      height="900"
    />
  </div>
) : (
  <div class={`project-art art--${project.visual}`} aria-hidden="true">
    <span class="art__index">{project.number} / MV·WORKS</span>
    <div class="art__inner">
      {project.visual === 'juridico' && (
        <div class="art__dashboard">
          <div class="art__bar"><i></i><i></i><i></i></div>
          <div class="art__dashboard-content">
            <div class="art__side"><b></b><b></b><b></b><b></b></div>
            <div class="art__main"><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
      )}
      {project.visual === 'prometeo' && <span class="art__grid" />}
      <span class="art__name">{project.visualTitle.split('\n').map((line) => <span>{line}</span>)}</span>
      <span class="art__tag">{project.category.en}</span>
    </div>
    <span class="art__bottom">{project.company}</span>
  </div>
)}
