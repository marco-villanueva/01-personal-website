---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from './ProjectVisual.astro';
import Contact from './Contact.astro';
import { projects, type Project } from '../data/projects';
import { dict, localPath, type Locale } from '../lib/paths';
interface Props { project: Project; lang: Locale; }
const { project, lang } = Astro.props;
const t = dict[lang];
const content = project.content[lang];
const next = projects[(projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length];
---
<BaseLayout lang={lang} path={`/work/${project.slug}`} title={project.title} description={content.summary}>
  <article>
    <div class="container case-head">
      <div class="case-breadcrumb">
        <a class="eyebrow" href={localPath('/work',lang)}>← {t.backWork}</a>
        <span class="eyebrow">{project.number} / 00{projects.length}</span>
      </div>
      <div class="case-heading">
        <h1>{project.title}<span style="color:var(--accent)">.</span></h1>
        <p>{content.headline}</p>
      </div>
    </div>
    <div class="container case-hero">
      <ProjectVisual project={project} />
      {project.screenshot && <p class="case-editorial-note" style="margin-top:.8rem">{lang === 'en' ? 'Live public site, captured November 2026. The design may have changed since the project period.' : 'Sitio público actual, capturado en noviembre de 2026. El diseño puede haber cambiado desde mi participación.'}</p>}
      <dl class="case-facts">
        <div><dt>{t.category}</dt><dd>{project.category[lang]}</dd></div>
        <div><dt>{t.role}</dt><dd>{project.role[lang]}</dd></div>
        <div><dt>{t.year}</dt><dd>{project.year}</dd></div>
        <div><dt>{t.stack}</dt><dd>{project.tech.slice(0,3).join(' · ')}</dd></div>
      </dl>
    </div>
    <div class="container case-body">
      <section class="case-block" aria-labelledby="case-context">
        <h2 id="case-context">01 / {t.problem}</h2>
        <div class="case-copy"><p>{content.context}</p></div>
      </section>
      <section class="case-block" aria-labelledby="case-contribution">
        <h2 id="case-contribution">02 / {t.contribution}</h2>
        <div class="case-copy"><ul>{content.contribution.map((item) => <li>{item}</li>)}</ul></div>
      </section>
      <section class="case-block" aria-labelledby="case-approach">
        <h2 id="case-approach">03 / {t.approach}</h2>
        <div class="case-copy">
          <p>{content.approach}</p>
          <div class="case-link-group eyebrow">{project.tech.map((tech) => <span>{tech}</span>)}</div>
        </div>
      </section>
      <section class="case-block" aria-labelledby="case-outcome">
        <h2 id="case-outcome">04 / {t.outcome}</h2>
        <div class="case-copy">
          <p>{content.reflection}</p>
          <div class="case-link-group">
            {project.website && <a class="text-link" href={project.website} target="_blank" rel="noopener noreferrer">{t.viewLive}<span aria-hidden="true">↗</span></a>}
            {project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">{t.viewCode}<span aria-hidden="true">↗</span></a>}
          </div>
          <p class="case-editorial-note">{project.screenshot ? (project.screenshotContext?.[lang] || (lang === 'en' ? 'This is a current public-site screenshot, not necessarily a depiction of the original project release.' : 'Es una captura del sitio público actual, que no necesariamente refleja la versión originalmente desarrollada.')) : t.galleryText}</p>
        </div>
      </section>
    </div>
    <nav class="container case-next" aria-label={t.next}>
      <a class="next-link" href={localPath(`/work/${next.slug}`,lang)}>
        <div><span class="eyebrow">{t.next} / {next.number}</span><h2>{next.title}</h2></div>
        <span class="round-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>
  </article>
  <Contact lang={lang}/>
</BaseLayout>
