---
import { dict, type Locale } from '../lib/paths';
interface Props { lang: Locale; id?: string; }
const { lang, id = 'contact' } = Astro.props;
const t = dict[lang];
---
<section class="contact-band" id={id}>
  <div class="container contact-band__inner">
    <div class="eyebrow"><span class="tiny-mark" aria-hidden="true"></span>{t.contactLabel}</div>
    <h2>{t.contactTitle}</h2>
    <a class="contact-band__link" href="mailto:marcovillanueva.m@gmail.com" aria-label="Send an email to Marco Villanueva">
      marcovillanueva.m@gmail.com <span aria-hidden="true">↗</span>
    </a>
    <p class="contact-band__note">{lang === 'en' ? 'For collaboration, projects or professional opportunities, send me an email or connect on LinkedIn.' : 'Para colaboraciones, proyectos u oportunidades profesionales, escríbeme o conecta conmigo en LinkedIn.'}</p>
    <a class="text-link" href="https://www.linkedin.com/in/marcovillanuevamx/" target="_blank" rel="noopener noreferrer" style="margin-top:1.75rem">LinkedIn <span aria-hidden="true">↗</span></a>
  </div>
</section>
