---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import Contact from './Contact.astro';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { dict, localPath, type Locale } from '../lib/paths';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = dict[lang];
const focus = [
  { number:'01', title:{en:'Frontend engineering',es:'Ingeniería frontend'}, text:{en:'Responsive interfaces, component systems, accessibility and the web platform.',es:'Interfaces responsive, sistemas de componentes, accesibilidad y plataforma web.'} },
  { number:'02', title:{en:'Web architecture',es:'Arquitectura web'}, text:{en:'Content platforms, modular applications, rendering strategies and integrations.',es:'Plataformas de contenido, aplicaciones modulares, estrategias de renderizado e integraciones.'} },
  { number:'03', title:{en:'Product development',es:'Desarrollo de productos'}, text:{en:'From early requirements to software that is useful, maintainable and ready to evolve.',es:'De los requisitos iniciales a software útil, mantenible y preparado para evolucionar.'} },
];
---
<BaseLayout lang={lang} path="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__frame">
      <div class="hero__top">
        <span class="eyebrow"><span class="tiny-mark"></span>{t.heroLabel}</span>
        <span class="eyebrow">{lang === 'en' ? 'PORTFOLIO / 2027 EDITION' : 'PORTAFOLIO / EDICIÓN 2027'}</span>
      </div>
      <h1 class="hero__title" id="hero-title">
        <span>Marco</span><span>Villanueva<span class="hero__period">.</span></span>
      </h1>
      <div class="hero__bottom">
        <p class="hero__intro">{t.heroIntro}</p>
        <div class="hero__aside">
          <p>{t.heroDescription}</p>
          <a class="hero__scroll" href="#selected"><span class="arrow-down" aria-hidden="true">↓</span>{t.explore}</a>
        </div>
      </div>
      <div class="hero__rule" aria-hidden="true"></div>
    </div>
  </section>

  <section class="section" id="selected" aria-labelledby="selected-heading">
    <div class="container">
      <div class="eyebrow-row">
        <span class="eyebrow">01 / {t.selected}</span>
        <span class="eyebrow">2024 — 2026</span>
      </div>
      <div class="section-header">
        <h2 id="selected-heading">{lang === 'en' ? 'The work.' : 'El trabajo.'}</h2>
        <p>{t.workIntro}</p>
      </div>
      <div class="project-grid">
        {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} lang={lang} featured={index === 0} />)}
      </div>
      <div class="section-footer">
        <a class="text-link" href={localPath('/work',lang)}>{t.allWork}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section expertise-section" aria-labelledby="focus-title">
    <div class="container">
      <div class="eyebrow-row">
        <span class="eyebrow">02 / {t.expertise}</span>
        <span class="eyebrow">PRACTICE / CAPABILITIES</span>
      </div>
      <h2 class="expertise-intro" id="focus-title">{lang === 'en' ? 'From the smallest interaction to the architecture behind it.' : 'De la interacción más pequeña a la arquitectura que la sostiene.'}</h2>
      <div class="expertise-list">
        {focus.map((item) => <div class="expertise-row"><span class="eyebrow">{item.number}</span><h3>{item.title[lang]}</h3><p>{item.text[lang]}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="container">
      <div class="eyebrow-row"><span class="eyebrow">03 / {t.experience}</span><span class="eyebrow">A BRIEF TIMELINE</span></div>
      <div class="section-header">
        <h2 id="experience-heading">{lang === 'en' ? 'The journey.' : 'La trayectoria.'}</h2>
        <p>{t.experienceIntro}</p>
      </div>
      <div class="experience-list">
        {experience.map((item) => <div class="experience-row"><span class="period">{item.period}</span><div><h3>{item.company}</h3><p>{item.role[lang]}</p></div><p>{item.note[lang]}</p></div>)}
      </div>
    </div>
  </section>

  <section class="about-teaser" aria-labelledby="teaser-title">
    <div class="container about-teaser__grid">
      <span class="eyebrow">04 / {t.navAbout}</span>
      <div>
        <h2 id="teaser-title">{lang === 'en' ? 'Engineering with an eye for detail and a habit of asking why.' : 'Ingeniería con atención al detalle y el hábito de preguntar por qué.'}</h2>
        <a class="text-link" href={localPath('/about',lang)}>{lang === 'en' ? 'More about my work' : 'Más sobre mi trabajo'} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <Contact lang={lang}/>
</BaseLayout>
